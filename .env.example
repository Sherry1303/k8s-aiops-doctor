# ---------------------------------------------------------------------------
# 环境变量样例（本文件可安全提交；真实密钥请写在 .env 或直接 export，已被 .gitignore 忽略）
#
# PowerShell 用法：
#     $env:DEEPSEEK_API_KEY = "sk-xxxxxxxx"
#     python k8s_doctor.py --once
# bash / zsh 用法：
#     export DEEPSEEK_API_KEY="sk-xxxxxxxx"
#     python k8s_doctor.py --once
# ---------------------------------------------------------------------------

# ---------- 大模型（AI 根因分析必需；只用采集/自愈时可不配，加 --no-llm） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ---------- 监听范围 ----------
K8S_NAMESPACE=default

# ---------- 自愈模式（--heal）默认替换镜像 ----------
HEAL_IMAGE=nginx:latest

# ---------- 邮件告警（SMTP；只要配置了 SMTP_HOST 就会自动开启发信） ----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
# QQ/163 邮箱需在网页端「设置 → 账号 → IMAP/SMTP 服务」生成【授权码】，不是登录密码
SMTP_PASSWORD=your-smtp-authorization-code
MAIL_TO=your@qq.com
